{
    "compilerOptions": {
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "node16",
        "target": "es2017",
        "allowJs": true,
        "noImplicitAny": true,
        "moduleResolution": "node16",
        "importHelpers": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "lib": ["DOM", "ES5", "ES6", "ES2017", "DOM.Iterable"]
    },
    "include": ["**/*.ts"]
}
